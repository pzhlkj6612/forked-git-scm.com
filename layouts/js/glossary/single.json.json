{{- $glossary := index .Site.Data.glossary .Params.lang | default dict -}}
{{- $base := strings.TrimSuffix "/" .Site.BaseURL -}}
{{- $resolved := dict -}}
{{- range $term, $def := $glossary -}}
  {{- $resolvedDef := replace $def `href="/` (printf `href="%s/` $base) -}}
  {{- $resolved = merge $resolved (dict $term $resolvedDef) -}}
{{- end -}}
{{- $resolved | jsonify -}}
